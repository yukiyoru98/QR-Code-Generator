# Shared
BASE_SHORT_URL=http://localhost:8000

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://mock-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=mock_upstash_token_12345

# Supabase
SUPABASE_URL=https://mock-project.supabase.co
SUPABASE_SECRET_KEY=mock_supabase_secret_key_12345

# Tinybird TypeScript SDK (dashboard)
TINYBIRD_TOKEN=p.your_workspace_token_here
TINYBIRD_URL=https://your-region.tinybird.co

# Tinybird HTTP ingestion (worker only)
TINYBIRD_INGEST_URL=https://your-region.tinybird.co/v0/events?name=scan_events
TINYBIRD_API_KEY=your_scan_events_append_token_here

# Optional malicious URL checker hook (real external check)
# If either variable is absent, checker gracefully falls back to allow.
MALICIOUS_CHECK_URL=https://example-security-provider.com/check
MALICIOUS_CHECK_API_KEY=mock_security_api_key_12345
